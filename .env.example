# ==============================================================================
# Krishna Vedic - Production & Local Environment Configuration
# ==============================================================================
# In Vercel: Set these under Project Settings -> Environment Variables.
# All VITE_* variables are baked into the frontend bundle at build time.
# All other variables are accessed by the serverless backend function (api/index.js).
# ==============================================================================

# ─── Environment & URLs ────────────────────────────────────────────────────────
NODE_ENV=production
# In production on Vercel, set CLIENT_URL to your primary domain:
CLIENT_URL=https://your-domain.vercel.app
# Additional comma-separated origins allowed by CORS (e.g. custom domain, localhost during dev)
ALLOWED_ORIGINS=https://your-domain.vercel.app,https://krishnavedic.com

# ─── Database (PostgreSQL / Aiven) ─────────────────────────────────────────────
# Cloud PostgreSQL connection string (include ?sslmode=require if using cloud DB like Aiven)
DATABASE_URL="postgresql://user:password@hostname:port/defaultdb?sslmode=require"

# ─── Authentication & Session ──────────────────────────────────────────────────
# Required in production: minimum 32 random characters (64+ recommended).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=GENERATE_AND_REPLACE_WITH_MINIMUM_32_CHAR_RANDOM_SECRET
SESSION_MAX_AGE=604800000

# Comma-separated list of authorized administrator email addresses
ADMIN_EMAILS=admin@krishnavedic.com

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Server-side Google OAuth verification
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Frontend Google OAuth client ID (exposed to client bundle)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ─── Razorpay Payment Gateway ──────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX

# ─── Cloudinary Image Storage ──────────────────────────────────────────────────
# Required for image uploads on Vercel (serverless filesystem is read-only)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ─── SMTP Email Notifications ──────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="Krishnavedic Oil & Masalas <care@krishnavedic.com>"

# ─── Store Identity (Frontend branding) ─────────────────────────────────────────
VITE_STORE_NAME="Krishnavedic Oil & Masalas"
VITE_STORE_EMAIL="care@krishnavedic.com"
VITE_STORE_ORDERS_EMAIL="orders@krishnavedic.com"
VITE_STORE_PHONE="+91 98201 45678"
VITE_STORE_PHONE_ALT="+91 91234 56789"
VITE_STORE_ADDRESS="Vedic Heritage Complex, Industrial Area Phase II, Jaipur, Rajasthan - 302013, India"
VITE_STORE_HOURS="Monday to Saturday: 9:00 AM to 7:00 PM IST"
VITE_STORE_FSSAI="11521018000342"
