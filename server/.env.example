# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://username:password@hostname:5432/defaultdb?sslmode=require&connection_limit=2"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ─── Session ──────────────────────────────────────────────────────────────────
SESSION_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET_AT_LEAST_64_CHARS_LONG
SESSION_MAX_AGE=604800000

# ─── Authorized Admin Accounts ──────────────────────────────────────────────
ADMIN_EMAILS=admin@example.com

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=XXXXXXXXXXXXXXXXXXXX

# ─── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── Resend Email Notifications ───────────────────────────────────────────────
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXX
ADMIN_NOTIFICATION_EMAIL=krishnavedic001@gmail.com
EMAIL_FROM="Krishna Vedic <onboarding@resend.dev>"


# ─── CORS ────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173
